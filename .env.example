# meetnote 配置。复制为 .env 后填写（install.ps1 会自动复制一份）。
# .env 只在本机，不要提交到 git，也不要发给别人。

# ---- 总结用的大模型（填一个即可）----
# DeepSeek：在 https://platform.deepseek.com 申请
DEEPSEEK_API_KEY=

# 其他 OpenAI 兼容服务（Kimi、通义、智谱等），三项都要填
# MEETNOTE_BASE_URL=
# MEETNOTE_API_KEY=
# MEETNOTE_MODEL=

# ---- 界面语言 / Interface language ----
# 提示信息、--help 和输出文件名用中文、英文还是德语；不填则跟随系统显示语言
# Messages, --help and output file names: zh, en or de; unset = follow the system display language
# Meldungen, --help und Dateinamen: zh, en oder de; leer = wie die Anzeigesprache des Systems
# MEETNOTE_LANG=zh

# ---- 网页服务 ----
# 访问码：设置后打开网页需要先输入，留空则不需要
MEETNOTE_ACCESS_CODE=

# 端口，默认 18765
# MEETNOTE_PORT=18765

# 监听地址：127.0.0.1 = 只通过 tailscale serve 访问（默认）；0.0.0.0 = 局域网也能直接访问
# MEETNOTE_HOST=127.0.0.1

# 任务数据目录，默认 %USERPROFILE%\meetnote-data
# MEETNOTE_DATA_DIR=
